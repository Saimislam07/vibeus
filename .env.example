# DevPulse Environment Configuration
# Database Connection (Default SQLite for instant setup, PostgreSQL/Supabase ready)
DATABASE_URL="file:./dev.db"

# JWT Secret for Session Encryption
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string-in-production"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Cloud Storage (e.g., AWS S3 / Supabase Storage / Cloudinary)
# STORAGE_PROVIDER="local"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_BUCKET=""
# S3_REGION=""
